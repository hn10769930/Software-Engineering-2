	    	if (table_name == "patients") { 
	    		System.out.println("Patient ID: " + entries[0]);
	    		System.out.println("Name: " + entries[1] + " " + entries[2]);
	    		System.out.println("DOB: " + entries[3]);
	    		System.out.println("Sex: " + entries[4]);
	    		System.out.println("Admitted at " + entries[5]);
	    		System.out.println("Discharged at " + entries[6]);
	    		System.out.println("Physisian Assistant: " + entries[7]);
	    		System.out.println("Emergency Contact: " + entries[8]);
	    		System.out.println("Insurance: " + entries[9]);
	    	}
	    	if (table_name == "procedures") {
	    		//Name	Procedure ID	Base Cost	Category
	    		System.out.println(entries[0] + "\n\tCost: " + entries[2] + "\n\t(" + entries[3] + ")");
	    	}
	    	if (table_name == "events") {
	    		//MRN	Proc. ID	Date	Time	Doctor	Paid?
	    		System.out.println("Date: " + entries[2] + "\t" + entries[3] + 
	    				"\n\tMRN: " + entries[0] + "\n\tProcedure ID: " + entries[1] + "\n\tDone by: " + entries[4]
	    				+ "\n\tPaid? " + entries[5]
	    				);
	    	}
	}
}